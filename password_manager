from cryptography.fernet import Fernet

key = Fernet.generate_key()
fernet = Fernet(key)

class Password:
    def __init__(self, website: str, user: str, plainpass: str):
        self.website = website
        self.user = user
        self.hashedpass = self._encrypt_pass(plainpass)

    def _encrypt_pass(self, plainpass: str) -> bytes:
        return fernet.encrypt(plainpass.encode('utf-8'))

    def verifypass(self, plainpass: str) -> bool:
        original = fernet.decrypt(self.hashedpass).decode('utf-8')
        return original == plainpass

class PasswordManager:
    def __init__(self):
        self.passwords = {}

    def input(self, prompt: str) -> str:
        return getpass.getpass(prompt=prompt)

    def addpass(self, website: str, user: str):
        if website in self.passwords:
            print(f" [!] Password for {website} already exists. Try updatepass, instead.")
            return
        newpass = self.input(f'Enter the password for {website} ({user}): ')
        passentry = Password(website, user, newpass)
        self.passwords[website] = passentry
        print(f" [+] Password for {website} added.")

    def retrievepass(self, website: str):
        if website not in self.passwords:
            print(f" [!] No password for {website} found.")
            return
        passentry = self.passwords[website]
        testpass = self.input(f'To verify, please input your password for {website}: ')
        if passentry.verifypass(testpass):
            print(f"[+] Password for {website} is correct.")
            print(f'Website: {website}')
            print(f'Username: {passentry.user}')
            print(f'Password: {fernet.decrypt(passentry.hashedpass).decode("utf-8")}')
        else:
            print(f" [!] Incorrect password for {website}. Verification failed.")

    def updatepass(self, website: str):
        if website not in self.passwords:
            print(f" [!] No password for {website} found.")
            return
        passentry = self.passwords[website]
        oldpass = self.input(f'Enter current password for {website} to update it: ')
        if not passentry.verifypass(oldpass):
            print(f" [!] Incorrect password for {website}. Update failed.")
            return
        newpass = self.input(f'Enter new password for {website}: ')
        passentry.hashedpass = passentry._encrypt_pass(newpass)
        print(f" [+] Password for {website} updated.")

    def listsites(self):
        if not self.passwords:
            print(f" [!] No passwords stored.")
            return
        print(f'Stored website entries:')
        for site in self.passwords:
            print(f' - {site}')

if __name__ == '__main__':
    password_manager = PasswordManager()
    while True:
        print(f'\nPassword Manager Menu:')
        print(f' 1. Add a new password entry')
        print(f' 2. Retrieve a password entry')
        print(f' 3. Update a password entry')
        print(f' 4. List all stored websites')
        print(f' 5. Quit')
        choice = input('Select a menu option (1-5): ').strip()
        if choice == '1':
            website = input('Enter website name: ').strip()
            user = input('Enter username: ').strip()
            password_manager.addpass(website, user)
        elif choice == '2':
            website = input('Enter website name to retrieve: ').strip()
            password_manager.retrievepass(website)
        elif choice == '3':
            website = input('Enter website name to update: ').strip()
            password_manager.updatepass(website)
        elif choice == '4':
            password_manager.listsites()
        elif choice == '5':
            print(f'Exiting...')
            break
        else:
            print(f'[!] Invalid option. Please select a valid option.')
